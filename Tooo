package com.radwan.nova.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.radwan.nova.data.models.Chat
import com.radwan.nova.data.remote.SupabaseManager
import com.radwan.nova.data.remote.RemoteMessage
import io.github.jan.supabase.gotrue.auth
import io.github.jan.supabase.postgrest.postgrest
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch

class HomeViewModel : ViewModel() {

    private val _chats = MutableStateFlow<List<Chat>>(emptyList())
    val chats: StateFlow<List<Chat>> = _chats.asStateFlow()

    private val _isLoading = MutableStateFlow(false)
    val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()

    init {
        loadChats()
        startPeriodicSync()
    }

    fun loadChats() {
        viewModelScope.launch {
            _isLoading.value = true
            fetchChats()
            _isLoading.value = false
        }
    }

    fun fetchRemoteChats() {
        loadChats()
    }

    fun logout(onLoggedOut: () -> Unit = {}) {
        viewModelScope.launch {
            try {
                SupabaseManager.auth.signOut()
                onLoggedOut()
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }
    }

    private fun startPeriodicSync() {
        viewModelScope.launch {
            while (isActive) {
                delay(2500)
                fetchChats()
            }
        }
    }

    private suspend fun fetchChats() {
        try {
            val user = SupabaseManager.auth.currentUserOrNull()
            val currentUserId = user?.id ?: ""
            val currentUserEmail = user?.email?.substringBefore("@") ?: ""

            if (currentUserId.isBlank() && currentUserEmail.isBlank()) {
                return
            }

            // جلب الرسائل
            val allMessages = SupabaseManager.postgrest["messages"]
                .select()
                .decodeList<RemoteMessage>()

            // فلترة الرسائل: إظهار المحادثات التي يكون المستخدم الحالي طرفاً فيها فقط!
            val myMessages = allMessages.filter { msg ->
                msg.sender_id == currentUserId || 
                (currentUserId.isNotBlank() && msg.chat_id.contains(currentUserId)) ||
                (currentUserEmail.isNotBlank() && msg.chat_id.contains(currentUserEmail))
            }

            val chatMap = mutableMapOf<String, RemoteMessage>()
            for (msg in myMessages) {
                chatMap[msg.chat_id] = msg
            }

            if (chatMap.isNotEmpty()) {
                val list = chatMap.map { (chatId, lastMsg) ->
                    // اسم المحادثة هو اسم الطرف الآخر
                    val otherName = if (lastMsg.sender_id != currentUserId && !lastMsg.sender_name.isNullOrBlank()) {
                        lastMsg.sender_name
                    } else {
                        // استخراج اسم الطرف الآخر من معرف المحادثة
                        val parts = chatId.split("__", "_")
                        val other = parts.firstOrNull { it != currentUserId && it != currentUserEmail }
                        other ?: "محادثة خاصة"
                    }

                    Chat(
                        id = chatId,
                        name = otherName,
                        lastMessage = lastMsg.text,
                        lastMessageTime = lastMsg.created_at ?: "",
                        avatarUrl = "",
                        unreadCount = 0
                    )
                }
                _chats.value = list
            } else {
                _chats.value = emptyList()
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }
}
