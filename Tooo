package com.radwan.nova.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.radwan.nova.data.models.Chat
import com.radwan.nova.data.remote.SupabaseManager
import com.radwan.nova.data.remote.RemoteMessage
import com.radwan.nova.data.remote.RemoteProfile
import io.github.jan.supabase.gotrue.auth
import io.github.jan.supabase.postgrest.postgrest
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch

class HomeViewModel : ViewModel() {

    private val _chats = MutableStateFlow<List<Chat>>(emptyList())
    val chats: StateFlow<List<Chat>> = _chats.asStateFlow()

    private val _isLoading = MutableStateFlow(false)
    val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()

    init {
        setUserOnlineStatus(true)
        loadChats()
        startPeriodicSync()
    }

    fun loadChats() {
        viewModelScope.launch {
            _isLoading.value = true
            fetchChats()
            _isLoading.value = false
        }
    }

    fun fetchRemoteChats() {
        loadChats()
    }

    private fun setUserOnlineStatus(isOnline: Boolean) {
        viewModelScope.launch {
            try {
                val user = SupabaseManager.auth.currentUserOrNull()
                val myId = user?.id
                if (!myId.isNullOrBlank()) {
                    SupabaseManager.postgrest["profiles"].update(
                        mapOf("is_online" to isOnline)
                    ) {
                        filter {
                            eq("id", myId)
                        }
                    }
                }
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }
    }

    fun logout(onLoggedOut: () -> Unit = {}) {
        viewModelScope.launch {
            try {
                // 1. تعيين حالة المستخدم أوفلاين في قاعدة البيانات فوراً
                val user = SupabaseManager.auth.currentUserOrNull()
                val myId = user?.id
                if (!myId.isNullOrBlank()) {
                    SupabaseManager.postgrest["profiles"].update(
                        mapOf("is_online" to false)
                    ) {
                        filter {
                            eq("id", myId)
                        }
                    }
                }
                // 2. تسجيل الخروج من Supabase
                SupabaseManager.auth.signOut()
                onLoggedOut()
            } catch (e: Exception) {
                e.printStackTrace()
                onLoggedOut()
            }
        }
    }

    private fun startPeriodicSync() {
        viewModelScope.launch {
            while (isActive) {
                delay(2000)
                fetchChats()
            }
        }
    }

    private suspend fun fetchChats() {
        try {
            val user = SupabaseManager.auth.currentUserOrNull()
            val myUsername = user?.email?.substringBefore("@")?.trim()?.lowercase() ?: ""
            val myUserId = user?.id?.trim()?.lowercase() ?: ""

            if (myUsername.isBlank() && myUserId.isBlank()) return

            val allMessages = SupabaseManager.postgrest["messages"]
                .select()
                .decodeList<RemoteMessage>()

            // جلب المحادثات التي يكون المستخدم الحالي طرفاً فيها فقط
            val myMessages = allMessages.filter { msg ->
                val room = msg.chat_id.lowercase()
                if (room.contains("__")) {
                    val participants = room.split("__").map { it.trim() }
                    participants.contains(myUsername) || (myUserId.isNotBlank() && participants.contains(myUserId))
                } else {
                    false
                }
            }

            // تجميع آخر رسالة لكل محادثة
            val chatMap = mutableMapOf<String, RemoteMessage>()
            for (msg in myMessages) {
                chatMap[msg.chat_id] = msg
            }

            if (chatMap.isNotEmpty()) {
                val list = chatMap.map { (roomId, lastMsg) ->
                    val participants = roomId.split("__").map { it.trim() }
                    val otherParty = participants.firstOrNull { it != myUsername && it != myUserId } ?: "محادثة"

                    Chat(
                        id = otherParty,
                        name = otherParty,
                        lastMessage = lastMsg.text,
                        lastMessageTime = lastMsg.created_at ?: "",
                        avatarUrl = "",
                        unreadCount = 0
                    )
                }
                _chats.value = list
            } else {
                _chats.value = emptyList()
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }
}
