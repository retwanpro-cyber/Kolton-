package com.radwan.nova.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.radwan.nova.data.models.Message
import com.radwan.nova.data.remote.SupabaseManager
import com.radwan.nova.data.remote.RemoteMessage
import io.github.jan.supabase.gotrue.auth
import io.github.jan.supabase.postgrest.postgrest
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.UUID

class ChatViewModel : ViewModel() {

    private val _messages = MutableStateFlow<List<Message>>(emptyList())
    val messages: StateFlow<List<Message>> = _messages.asStateFlow()

    private val _isLoading = MutableStateFlow(false)
    val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()

    private var activeChatId: String? = null

    // تنظيف وتوحيد معرف الغرفة المشتركة بين أي طرفين
    private fun getPrivateChatId(rawInput: String): String {
        val user = SupabaseManager.auth.currentUserOrNull()
        val myName = (user?.email?.substringBefore("@") ?: user?.id ?: "user").trim().lowercase()
        val target = rawInput.trim().lowercase()

        // إذا كانت الغرفة مدمجة مسبقاً (مثلاً: user1__user2)
        if (target.contains("__")) {
            val parts = target.split("__").map { it.trim() }.sorted()
            return "${parts[0]}__${parts[1]}"
        }

        // دمج الاسمين ترتيباً أبجدياً لتطابق الغرفة عند كلا الطرفين 100%
        return if (myName < target) {
            "${myName}__${target}"
        } else {
            "${target}__${myName}"
        }
    }

    fun loadMessages(chatId: String) {
        if (chatId.isBlank()) return
        val targetRoom = getPrivateChatId(chatId)
        activeChatId = targetRoom

        viewModelScope.launch {
            _isLoading.value = true
            fetchMessages(targetRoom)
            _isLoading.value = false

            // مزامنة حية كل ثانية لجلب أي رسالة يرسلها الطرف الآخر فوراً
            while (isActive && activeChatId == targetRoom) {
                delay(1500)
                fetchMessages(targetRoom)
            }
        }
    }

    private suspend fun fetchMessages(targetRoom: String) {
        try {
            val remoteList = SupabaseManager.postgrest["messages"]
                .select {
                    filter {
                        eq("chat_id", targetRoom)
                    }
                }
                .decodeList<RemoteMessage>()

            val mapped = remoteList.map { r ->
                Message(
                    id = r.id ?: UUID.randomUUID().toString(),
                    chatId = r.chat_id,
                    senderId = r.sender_id ?: "",
                    senderName = r.sender_name ?: "مستخدم",
                    text = r.text,
                    timestamp = r.created_at ?: ""
                )
            }
            _messages.value = mapped
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    fun sendMessage(chatId: String, text: String) {
        if (text.isBlank() || chatId.isBlank()) return

        val targetRoom = getPrivateChatId(chatId)
        val user = SupabaseManager.auth.currentUserOrNull()
        val currentUserId = user?.id ?: "guest"
        val currentUserName = user?.email?.substringBefore("@") ?: "مستخدم"
            
        val newMsgId = UUID.randomUUID().toString()
        val currentTimeStr = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault()).format(Date())

        val newMsg = Message(
            id = newMsgId,
            chatId = targetRoom,
            senderId = currentUserId,
            senderName = currentUserName,
            text = text.trim(),
            timestamp = currentTimeStr
        )
        
        _messages.value = _messages.value + newMsg

        viewModelScope.launch {
            try {
                val remote = RemoteMessage(
                    id = newMsgId,
                    chat_id = targetRoom,
                    sender_id = currentUserId,
                    text = text.trim(),
                    sender_name = currentUserName
                )
                SupabaseManager.postgrest["messages"].insert(remote)
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }
    }
}
